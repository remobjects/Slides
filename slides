#!/bin/bash
# macOS launcher for a single installed ESP Slides app.
set -euo pipefail

if (( $# > 2 )); then
  echo "Usage: slides [deck.md [port]]" >&2
  exit 2
fi

app_dir=$(dirname "$(realpath "$0")")
deck=$(realpath "${1:-$app_dir/Site/App_Data/slides.md}")
if [[ ! -f "$deck" || ! -r "$deck" ]]; then
  echo "Cannot read the Markdown deck at $deck" >&2
  exit 2
fi

export ESP_SLIDES_DECK="$deck"
exec ebuild --serve-web-project "$app_dir/Site" --configuration:Debug "--port:${2:-8055}"
